# Copy this file to `.env` in THIS directory (AF_repo/.env) and fill in your keys.
# Every script loads AF_repo/.env via python-dotenv (paths are resolved relative to
# this repo root, so nothing outside AF_repo/ is referenced).

# Required: benchmark construction, target fine-tuning, MCQ eval, the auditor agent,
# the row-flagging classifier, and OpenAI-based forecasters.
OPENAI_API_KEY=

# Required: models routed through OpenRouter — the benign-QA verifier (claude-sonnet),
# the MCQ frontier trio, most non-OpenAI/Anthropic vanilla forecasters, and the
# decomposed forecaster's Gemini 2.5 Pro reader (gamma).
OPENROUTER_API_KEY=

# Required: Anthropic vanilla forecasters (Claude family).
ANTHROPIC_API_KEY=

# Required: open-weight fine-tuning + sampling via Tinker (LoRA) and the eval proxy.
TINKER_API_KEY=

# Optional: point the data-editing loop at a different datasets dir / allowlist.
# Defaults to main/data/datasets when unset.
# DATA_ITERATION_DATASETS_DIR=
# DATA_ITERATION_DATASETS=
